# Copie para .env e preencha. O .env NUNCA vai para o git (.gitignore).
# Provedor do modelo (API compatível com OpenAI). Hosts aceitos: ver config.HOSTS_LLM_PERMITIDOS.
LLM_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# Opcional: preço do modelo em US$ por 1 milhão de tokens (métrica de custo).
PRECO_ENTRADA_MTOK=
PRECO_SAIDA_MTOK=

# Opcional: envia os traces também por OTLP/HTTP (Jaeger, Phoenix, Tempo...).
OTEL_EXPORTER_OTLP_ENDPOINT=
